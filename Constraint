
## CLOCK - 100 MHz
set_property PACKAGE_PIN E3 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
create_clock -period 10.000 -name sys_clk [get_ports clk]

## RESET - BTNC
set_property PACKAGE_PIN N17 [get_ports reset]
set_property IOSTANDARD LVCMOS33 [get_ports reset]

## PASSWORD - SWITCHES SW0 to SW3
set_property PACKAGE_PIN J15 [get_ports {password[0]}]
set_property PACKAGE_PIN L16 [get_ports {password[1]}]
set_property PACKAGE_PIN M13 [get_ports {password[2]}]
set_property PACKAGE_PIN R15 [get_ports {password[3]}]

set_property IOSTANDARD LVCMOS33 [get_ports {password[*]}]

## ENTER BUTTON - BTNU
set_property PACKAGE_PIN M18 [get_ports enter_btn]
set_property IOSTANDARD LVCMOS33 [get_ports enter_btn]

## UNLOCK LED - LD0
set_property PACKAGE_PIN H17 [get_ports unlock_led]
set_property IOSTANDARD LVCMOS33 [get_ports unlock_led]

## LOCKOUT LED - LD1
set_property PACKAGE_PIN K15 [get_ports lockout_led]
set_property IOSTANDARD LVCMOS33 [get_ports lockout_led]

## ATTEMPT LEDS - LD2 and LD3
set_property PACKAGE_PIN J13 [get_ports {attempt_led[0]}]
set_property PACKAGE_PIN N14 [get_ports {attempt_led[1]}]

set_property IOSTANDARD LVCMOS33 [get_ports {attempt_led[*]}]
