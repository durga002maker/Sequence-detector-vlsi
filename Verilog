
module digital_lock #(
    parameter [3:0] CORRECT_PASSWORD = 4'b1010
)(
    input wire clk,
    input wire reset,
    input wire [3:0] password,
    input wire enter_btn,

    output wire unlock_led,
    output wire lockout_led,
    output wire [1:0] attempt_led
);

    // FSM states
    parameter IDLE    = 2'b00;
    parameter OPEN    = 2'b01;
    parameter LOCKOUT = 2'b10;

    reg [1:0] state;
    reg [1:0] attempts;

    // Synchronize enter button
    reg enter_meta;
    reg enter_sync;
    reg enter_sync_d;

    wire enter_pulse;

    assign enter_pulse = enter_sync & ~enter_sync_d;

    always @(posedge clk) begin
        if (reset) begin
            enter_meta   <= 0;
            enter_sync   <= 0;
            enter_sync_d <= 0;
        end
        else begin
            enter_meta   <= enter_btn;
            enter_sync   <= enter_meta;
            enter_sync_d <= enter_sync;
        end
    end

    // Main FSM operation
    always @(posedge clk) begin
        if (reset) begin
            state    <= IDLE;
            attempts <= 0;
        end
        else begin
            case (state)

                IDLE: begin
                    if (enter_pulse) begin
                        if (password == CORRECT_PASSWORD) begin
                            state    <= OPEN;
                            attempts <= 0;
                        end
                        else begin
                            if (attempts == 2) begin
                                attempts <= 3;
                                state <= LOCKOUT;
                            end
                            else begin
                                attempts <= attempts + 1;
                            end
                        end
                    end
                end

                OPEN: begin
                    state <= OPEN;
                end

                LOCKOUT: begin
                    state <= LOCKOUT;
                end

                default: begin
                    state <= IDLE;
                    attempts <= 0;
                end

            endcase
        end
    end

    // Output logic
    assign unlock_led  = (state == OPEN);
    assign lockout_led = (state == LOCKOUT);
    assign attempt_led = attempts;

endmodule
